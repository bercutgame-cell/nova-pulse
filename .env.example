# Required: HTTP Basic Auth password (username is admin)
# NOVA_ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional persistent SQLite location; must point to a persistent disk mount
# NOVA_DB_PATH=/var/data/nova_pulse.db
# Telegram integration (not active in MVP 0.1)
# BOT_TOKEN=
# ADMIN_TELEGRAM_ID=
